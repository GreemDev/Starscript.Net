<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="GrukeAlpha" value="https://gitlab.com/api/v4/projects/79839956/packages/nuget/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="GrukeAlpha">
            <package pattern="GreemDev.Nuke" />
            <package pattern="GreemDev.Nuke.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>